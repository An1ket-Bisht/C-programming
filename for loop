#include<stdio.h>
int main(){
    int n;
    printf("Enter a number: ");
    scanf("%d",&n);
    int a;

    for(int i=2; i<=n-1; i++){
        if(n%i==0){
            a=0;
            break;
        }
    }
        if(a==0) printf("the number is composite");
        else printf("the number is prime");

    return 0;
}
